# App Factory Environment Configuration Template
# Copy this file to .env and fill in your values

# 1. Multi-Agent CLI Paths (Leave empty to use PATH discovery)
CLAUDE_BIN=claude
CODEX_BIN=codex
HERMES_BIN=hermes

# 2. Preferred Models per Role
CPO_MODEL=claude-3-7-sonnet
CSO_MODEL=gpt-5.2-codex
QA_MODEL=gemini-3.8-flash

# 3. Optional Gateway Settings (if using reverse proxy or custom endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CPA_GATEWAY_URL=https://cpa.huppy.ai/v1

# 4. Host Compiler Verification Flags
AUTO_FIX_TESTS=true
STRICT_TDD=true
STRICT_CSO=true
MAX_FIX_ROUNDS=3
